{
  "name": "@xyz2zyx/composer-markdown",
  "version": "1.3.5",
  "description": "Live Markdown rendering attached to the DSH Web composer, with a source-preserving toggle in the composer tool row.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "markdown",
    "composer",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYZ0901/dsh-composer-markdown.git"
  },
  "homepage": "https://github.com/XYZ0901/dsh-composer-markdown#readme",
  "bugs": {
    "url": "https://github.com/XYZ0901/dsh-composer-markdown/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
